# --- Server ---
PORT=3000
BASE_URL=https://your-deployed-domain.com   # public URL once deployed (used for webhook URLs)

# --- Shopify Admin API ---
# Create a custom app in Shopify Dev Dashboard, then App settings tab ->
# Client ID + Client secret. The app exchanges these for a short-lived
# access token itself (lib/shopify.js) -- no static token to paste anymore.
# Scopes needed on the app: write_orders, read_orders, read_fulfillments
SHOPIFY_STORE_DOMAIN=nailpopstudio.myshopify.com
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2024-10
# From Settings > Notifications > Webhooks, bottom of page, after you add
# the fulfillments/create webhook there (see README step 4).
SHOPIFY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxx

# --- Documenso (self-hosted e-signature — free, no per-webhook plan) ---
# URL of your own Documenso instance (see README "Documenso setup").
DOCUMENSO_API_URL=https://your-documenso-instance.up.railway.app/api/v2
DOCUMENSO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Any random string — set the same value as the webhook's secret when you
# create it in Documenso's Settings > Webhooks.
DOCUMENSO_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxx

# --- Tracking ---
# Manual — visit /admin/orders?token=ADMIN_TOKEN to see shipped orders and
# click "Mark Delivered" when a package arrives; that starts the day
# 7/10/13 follow-up clock. Pick any random string for ADMIN_TOKEN.
ADMIN_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email ---
# Day 7/10/13 follow-up emails send directly via Resend — reuse the same
# Resend account/verified domain set up for contract emails.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_ADDRESS=Your Brand <ambassador@yourdomain.com>
